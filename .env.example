# Google Cloud OAuth client type: Web application. Enable Search Console API,
# Google Analytics Admin API, and Google Analytics Data API in that project.
# For local use, register http://localhost:3000/api/google/callback.
# For Vercel, register https://seo-command-center-six.vercel.app/api/google/callback
# and set APP_BASE_URL to https://seo-command-center-six.vercel.app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
# Generate a private 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing the key invalidates all existing local Google sessions.
TOKEN_ENCRYPTION_KEY=

# Vercel hosted workspace only. Set a unique 16+ character password in the
# Vercel Production environment before opening the deployed workspace.
# Do not commit real values here. Neon integration provides DATABASE_URL.
SEO_ACCESS_PASSWORD=
# Optional until scheduled workflows are enabled on Vercel.
CRON_SECRET=

# Clerk Organizations. Keep both switches disabled until every hosted workspace,
# report, and integration-token vault has organization-scoped storage.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTH_ENABLED=0
CLERK_ORG_STORAGE_READY=0
# Optional: assign the existing single-user hosted workspace and connected
# Google/Meta vaults to this Clerk organization on its first visit.
CLERK_LEGACY_OWNER_ORG_ID=

# Optional PageSpeed quota key. Public requests can be rate-limited without one.
PAGESPEED_API_KEY=

# Optional email notifications. Set destinations in each schedule in SEO Command Center.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional WordPress connection: one HTTPS origin, a dedicated editor account,
# and its application password. Never use your normal WordPress login password.
WP_SITE_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# Signal Meta connection. Create/configure a Meta app and register this callback:
# https://seo-command-center-six.vercel.app/api/meta/callback
# Instagram publishing requires a Professional account linked to a managed Page.
META_APP_ID=
META_APP_SECRET=
# Optional Graph API version; defaults to v22.0.
META_GRAPH_API_VERSION=v22.0

# Optional private persistence directory. Default is this app's ignored .data/.
# ORBIT_DATA_DIR=
